FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    git \
    curl \
    jq \
    gcc \
    g++ \
    make \
    cmake \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install PlatformIO and dependencies
RUN pip install --upgrade pip && \
    pip install platformio esptool pyyaml

# Copy workspace
COPY . .

CMD ["/bin/bash"]
